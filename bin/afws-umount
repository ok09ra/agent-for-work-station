#!/bin/zsh

set -eu

readonly AFWS_PROGRAM="afws-umount"
readonly SCRIPT_DIR="${0:A:h}"

for afws_library in \
  "${SCRIPT_DIR}/../lib/afws-common.zsh" \
  "${HOME}/.local/lib/afws-common.zsh"; do
  if [[ -r "$afws_library" ]]; then
    source "$afws_library"
    break
  fi
done

if ! typeset -f afws_die >/dev/null; then
  print -u2 -r -- "${AFWS_PROGRAM}: cannot find lib/afws-common.zsh; run ./scripts/install.sh"
  exit 2
fi

readonly PEERS="${SCRIPT_DIR}/afws-peers"

force=0
dry_run=0
orphaned=0
list_only=0
ssh_host=""
remote_dir=""

usage() {
  print -r -- "Usage:"
  print -r -- "  afws-umount SSH_CONFIG_HOST REMOTE_ABSOLUTE_DIRECTORY [--force]"
  print -r -- "  afws-umount --orphaned [--force]"
  print -r -- "  afws-umount --list"
  print -r -- ""
  print -r -- "--orphaned also closes a shared SSH connection no live session is using."
  print -r -- "Such a connection is authenticated, so leaving one open is worth avoiding."
  print -r -- ""
  print -r -- "Releases mounts created under the mount base. A session normally unmounts"
  print -r -- "its own workspace when it exits; this command is for a mount left behind by"
  print -r -- "a background session, by a session that was killed, or by a dead sshfs."
  print -r -- ""
  print -r -- "Options:"
  print -r -- "  --orphaned     Release every mount no live session is using."
  print -r -- "  --list         Show the mounts and how many sessions use each."
  print -r -- "  --force        Use 'diskutil unmount force' when a plain umount fails."
  print -r -- "  -n, --dry-run  Print what would be released, change nothing."
}

while (( $# > 0 )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --orphaned) orphaned=1; shift ;;
    --list) list_only=1; shift ;;
    --force) force=1; shift ;;
    -n|--dry-run) dry_run=1; shift ;;
    -*) afws_die "unknown option: $1" ;;
    *)
      if [[ -z "$ssh_host" ]]; then
        ssh_host="$1"
      elif [[ -z "$remote_dir" ]]; then
        remote_dir="$1"
      else
        afws_die "unexpected argument: $1"
      fi
      shift
      ;;
  esac
done

if (( list_only )) || (( orphaned )); then
  [[ -z "$ssh_host" ]] || afws_die "--orphaned and --list take no host or directory"
else
  [[ -n "$ssh_host" && -n "$remote_dir" ]] || { usage >&2; exit 2; }
  afws_validate_host "$ssh_host"
  remote_dir="$(afws_normalize_remote_dir "$remote_dir")"
fi

typeset -a afws_mounts
afws_mounts=()

collect_mounts() {
  local mount_line remainder mount_path

  while IFS= read -r mount_line; do
    remainder="${mount_line#* on }"
    mount_path="${remainder%% \(*}"
    [[ "$mount_path" == "${AFWS_MOUNT_BASE}/"* ]] || continue
    afws_mounts+=("$mount_path")
  done < <(${=AFWS_MOUNT_COMMAND})
}

users_of_host() {
  local host="$1" users

  if [[ -x "$PEERS" ]]; then
    users="$("$PEERS" --users-of-host "$host" 2>/dev/null)" || users=0
  else
    users=0
  fi

  print -r -- "$users"
}

users_of() {
  local point="$1" users

  if [[ -x "$PEERS" ]]; then
    users="$("$PEERS" --users-of-mount "$point" 2>/dev/null)" || users=0
  else
    users=0
  fi

  print -r -- "$users"
}

release() {
  local point="$1"

  if (( dry_run )); then
    print -r -- "Would unmount ${point}"
    return 0
  fi

  print -r -- "Unmounting ${point}"
  if umount "$point" 2>/dev/null; then
    return 0
  fi

  if (( force )); then
    if diskutil unmount force "$point" >/dev/null 2>&1; then
      print -r -- "  released with diskutil unmount force"
      return 0
    fi
  fi

  print -u2 -r -- "${AFWS_PROGRAM}: could not unmount ${point}"
  print -u2 -r -- "  close anything sitting in it, then retry with --force"
  return 1
}

collect_mounts

if (( list_only )); then
  if (( ${#afws_mounts} == 0 )) && [[ -z "$(print -rl -- "$AFWS_CONTROL_DIR"/*.sock(N))" ]]; then
    print -r -- "No work-station mounts or shared connections are present."
    exit 0
  fi
  printf '%-8s %s\n' SESSIONS "MOUNT POINT"
  for point in "${afws_mounts[@]}"; do
    printf '%-8s %s\n' "$(users_of "$point")" "$point"
  done

  for socket in "$AFWS_CONTROL_DIR"/*.sock(N); do
    printf '%-8s shared SSH connection to %s\n' \
      "$(users_of_host "${socket:t:r}")" "${socket:t:r}"
  done
  exit 0
fi

failures=0

if (( orphaned )); then
  released=0
  for point in "${afws_mounts[@]}"; do
    if [[ "$(users_of "$point")" == 0 ]]; then
      release "$point" || failures=$(( failures + 1 ))
      released=$(( released + 1 ))
    fi
  done
  if (( released == 0 )); then
    print -r -- "Every work-station mount is still in use by a live session."
  fi

  # A shared SSH connection outliving its sessions is an authenticated channel
  # nobody is watching, so it is closed here too.
  closed=0
  for socket in "$AFWS_CONTROL_DIR"/*.sock(N); do
    socket_host="${socket:t:r}"
    [[ "$(users_of_host "$socket_host")" == 0 ]] || continue
    if (( dry_run )); then
      print -r -- "Would close the shared SSH connection to ${socket_host}"
    else
      print -r -- "Closing the shared SSH connection to ${socket_host}"
      afws_close_control_master "$socket_host" "$socket"
      rm -f "$socket"
    fi
    closed=$(( closed + 1 ))
  done
  (( closed > 0 )) || print -r -- "No unused shared SSH connections."

  (( failures == 0 )) || exit 1
  exit 0
fi

target="${AFWS_MOUNT_BASE}/${ssh_host}${remote_dir}"

if [[ ${afws_mounts[(Ie)$target]} -eq 0 ]]; then
  print -r -- "Not mounted: ${target}"
  exit 0
fi

users="$(users_of "$target")"
if [[ "$users" != 0 ]] && (( ! force )); then
  afws_die "${users} live session(s) are still working in ${target}
Check them with afws-peers, or pass --force to unmount anyway."
fi

release "$target" || exit 1
