#!/bin/zsh

set -eu

readonly AFWS_PROGRAM="codexfws"
readonly SCRIPT_DIR="${0:A:h}"

for afws_library in \
  "${SCRIPT_DIR}/../lib/afws-common.zsh" \
  "${HOME}/.local/lib/afws-common.zsh"; do
  if [[ -r "$afws_library" ]]; then
    source "$afws_library"
    break
  fi
done

if ! typeset -f afws_die >/dev/null; then
  print -u2 -r -- "${AFWS_PROGRAM}: cannot find lib/afws-common.zsh; run ./scripts/install.sh"
  exit 2
fi

readonly PEERS="${SCRIPT_DIR}/afws-peers"
dry_run=0

usage() {
  print -r -- "Codex CLI for Work Station"
  print -r -- ""
  print -r -- "Usage:"
  print -r -- "  codexfws"
  print -r -- "  codexfws SSH_CONFIG_HOST REMOTE_ABSOLUTE_DIRECTORY [CODEX_ARGS ...]"
  print -r -- "  codexfws --dry-run SSH_CONFIG_HOST REMOTE_ABSOLUTE_DIRECTORY"
  print -r -- ""
  print -r -- "Options:"
  print -r -- "  -n, --dry-run       Print the planned mount and launch, change nothing."
  print -r -- ""
  print -r -- "With no arguments, codexfws prompts for the SSH host and remote directory."
  print -r -- ""
  print -r -- "Environment:"
  print -r -- "  AFWS_MOUNT_BASE          Mount root (default: HOME/afws-mounts)"
  print -r -- "  AFWS_STATE_DIR           Registry root (default: HOME/.afws)"
  print -r -- "  AFWS_SESSION_NAME        Use this session name instead of a generated one"
  print -r -- "  AFWS_NO_CONTROL_MASTER   Do not share one authenticated SSH connection"
  print -r -- "  AFWS_KEEP_MOUNT          Leave the mount in place when the session ends"
  print -r -- ""
  print -r -- "Codex CLI cannot be given a session name at launch, cannot report its"
  print -r -- "sessions in machine-readable form, and has no shell wrapper, so a Codex"
  print -r -- "session is registered and can take locks but cannot be messaged by name"
  print -r -- "and has no status column. See docs/agents.md."
}

while (( $# > 0 )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -n|--dry-run) dry_run=1; shift ;;
    *) break ;;
  esac
done

if (( $# == 0 )); then
  if [[ ! -t 0 ]]; then
    afws_die "interactive input requires a terminal"
  fi
  read -r "ssh_host?SSH config host: "
  read -r "remote_dir?Remote absolute project directory: "
elif (( $# >= 2 )); then
  ssh_host="$1"
  remote_dir="$2"
  shift 2
else
  usage >&2
  exit 2
fi

afws_validate_host "$ssh_host"
remote_dir="$(afws_normalize_remote_dir "$remote_dir")"

if (( ! dry_run )); then
  for dependency in ssh sshfs codex; do
    command -v "$dependency" >/dev/null 2>&1 ||
      afws_die "required command not found: ${dependency}; run afws-doctor"
  done

  for helper in afws-run afws-peers afws-lock; do
    [[ -x "${SCRIPT_DIR}/${helper}" ]] ||
      afws_die "${helper} is not installed next to codexfws"
  done
fi

# --- session naming -------------------------------------------------------
# Codex CLI has no launch-time name flag, so the name is registry bookkeeping:
# it identifies the session in afws-peers and as a lock holder, but it is not a
# name Codex itself knows.

if (( ! dry_run )) && [[ -x "$PEERS" ]]; then
  "$PEERS" --prune --quiet 2>/dev/null || true
fi

if [[ -n "${AFWS_SESSION_NAME-}" ]]; then
  afws_validate_session_name "$AFWS_SESSION_NAME"
  session_name="$AFWS_SESSION_NAME"
else
  session_base="cx-$(afws_sanitize_component "$ssh_host")-$(afws_sanitize_component "${remote_dir:t}")"
  session_name="$(afws_allocate_session_name "$session_base")" ||
    afws_die "could not allocate a session name; run afws-peers --prune"
fi

# --- shared SSH connection ------------------------------------------------

control_socket="$(afws_control_socket "$ssh_host")"
use_control_master=1
[[ -n "${AFWS_NO_CONTROL_MASTER-}" ]] && use_control_master=0

if (( use_control_master )); then
  afws_check_socket_length "$control_socket"
fi

if (( ! dry_run )) && (( use_control_master )); then
  afws_open_control_master "$ssh_host" "$control_socket" ||
    afws_die "could not open an SSH connection to ${ssh_host}; run afws-doctor ${ssh_host}"
fi

# --- mount ----------------------------------------------------------------

if afws_find_existing_mount "$ssh_host" "$remote_dir"; then
  local_workspace="$afws_local_workspace"
  mount_point="$afws_mount_point"
  print -r -- "Reusing SSHFS mount: ${afws_mount_source}"
elif [[ -n "$afws_stale_mount" ]]; then
  afws_die "$(afws_stale_mount_message "$afws_stale_mount")"
else
  local_workspace="${AFWS_MOUNT_BASE}/${ssh_host}${remote_dir}"
  mount_point="$local_workspace"

  if afws_find_nested_mount "$local_workspace"; then
    afws_die "refusing to mount ${ssh_host}:${remote_dir} on ${local_workspace}
Another mount is already in use underneath it: ${afws_nested_mount}
That mount belongs to a session working on a subdirectory of this one. Start this
session on that deeper directory instead, or unmount it first. Run afws-peers to
see which session it belongs to."
  fi

  if (( dry_run )); then
    print -r -- "Would mount ${ssh_host}:${remote_dir}"
    print -r -- "  on ${local_workspace}"
    (( use_control_master )) &&
      print -r -- "  over a shared SSH connection at ${control_socket}"
  else
    (( use_control_master )) && mount_socket="$control_socket" || mount_socket=""
    afws_mount "$ssh_host" "$remote_dir" "$local_workspace" "$mount_socket" \
      "${AFWS_LOG_DIR}/${session_name}.sshfs.log" || exit 1
  fi
fi

# --- session instructions -------------------------------------------------

remote_runner="afws-run ${ssh_host} --cwd ${(q)remote_dir}"
developer_instructions="This is an agent-for-work-station session backed by an SSHFS mount.
Session name: ${session_name}
SSH config host: ${ssh_host}
Local workspace: ${local_workspace}
Remote working directory: ${remote_dir}

Operating rules:
- Read and edit files only within the current mounted workspace unless the user explicitly expands scope.
- Use local filesystem tools for inspection and editing; the workspace is the remote project itself, so every write lands on the remote host.
- Run Python, tests, builds, GPU jobs, and other commands that depend on the remote environment through: ${remote_runner} -- COMMAND ARG...
- To send a shell script through standard input, pipe it to: ${remote_runner}
- Do not install or update packages, alter shell startup files, or modify the remote system or user environment without explicit user approval.
- Show the remote command and its relevant stdout and stderr to the user.
- Ask before destructive operations or before starting expensive or long-running jobs.
- SSHFS is a network filesystem: prefer one remote command over many small local file operations when scanning large trees.
- Commands you run with the ordinary shell run on this Mac, not on the workstation, even though the files are the workstation's. Only ${remote_runner} reaches the workstation.

Multi-session rules:
- Other sessions, of this agent or of Claude Code, may be attached to this same workstation. Run 'afws-peers' to see which session is working on which SSH host and remote directory, and 'afws-peers --same' for the ones sharing this exact remote directory.
- This session is registered as '${session_name}'.
- Before using an exclusive remote resource (a GPU, a shared build or output directory, a dataset being rewritten, a single git worktree), claim it with: afws-lock acquire NAME
  Release it when finished with: afws-lock release NAME
  If the lock is held, 'afws-lock status NAME' names the holder. Report the wait to the user; never take a held lock without the user saying so.
- Do not modify files another session is working on. Ask the user to coordinate."

print -r -- "Codex CLI for Work Station"
print -r -- "  session: ${session_name}"
print -r -- "  ssh:     ${ssh_host}"
print -r -- "  remote:  ${remote_dir}"
print -r -- "  local:   ${local_workspace}"

if [[ -x "$PEERS" ]]; then
  if (( dry_run )); then
    peer_count="$("$PEERS" --count --no-prune 2>/dev/null || print -r -- 0)"
  else
    peer_count="$("$PEERS" --count 2>/dev/null || print -r -- 0)"
  fi
  print -r -- "  peers:   ${peer_count}"
fi

if (( dry_run )); then
  print -r -- "Would start Codex with:"
  print -r -- "  codex --no-alt-screen -C ${(q)local_workspace} --sandbox workspace-write --ask-for-approval on-request --config developer_instructions=<session instructions>"
  print -r -- "Would record the session as ${AFWS_SESSION_DIR}/${session_name}.conf"
  exit 0
fi

# --- registry and session environment -------------------------------------

afws_agent=codex
afws_session_name="$session_name"
afws_ssh_host="$ssh_host"
afws_remote_dir="$remote_dir"
afws_local_workspace="$local_workspace"
afws_mount_point="$mount_point"
afws_control_socket_path="$control_socket"

export AFWS_AGENT=codex
export AFWS_SESSION_NAME="$session_name"
export AFWS_SSH_HOST="$ssh_host"
export AFWS_REMOTE_DIR="$remote_dir"
export AFWS_LOCAL_WORKSPACE="$local_workspace"

if [[ -S "$control_socket" ]]; then
  export AFWS_CONTROL_PATH="$control_socket"
fi

# Codex takes the workspace with -C, so this shell stays outside the mount and
# nothing has to be moved out of the way before unmounting.

afws_write_session_record interactive "$$" ""

release() { afws_release_session "$PEERS"; }
trap release EXIT
trap '' INT

session_exit=0
codex \
  --no-alt-screen \
  -C "$local_workspace" \
  --sandbox workspace-write \
  --ask-for-approval on-request \
  --config "developer_instructions=${developer_instructions}" \
  "$@" || session_exit=$?

exit "$session_exit"
