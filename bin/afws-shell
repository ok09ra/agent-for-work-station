#!/bin/sh
#
# Runs a shell command for an agent-for-work-station session and labels it as
# having run on this Mac. The workspace is an SSHFS mount, so paths are remote
# but execution is local; the label is what makes that visible instead of
# silent. Nothing is blocked: a command that belongs on the workstation is
# still run here, it just says so.
#
# claudefws points CLAUDE_CODE_SHELL_PREFIX at this script for its own sessions.
# Codex CLI has no equivalent hook, so Codex sessions are not labelled.

# The agent hands the whole shell script over as a single argument. Anything
# else means the contract changed, so behave as a transparent shell instead.
if [ "$#" -ne 1 ]; then
  exec "$@"
fi

# The shell itself always runs here, whatever the command goes on to do, so
# this label is about where execution started. A command that hands work to the
# workstation is labelled by afws-run, which knows that it did.
# Always, for every command: the shell runs here whatever the command goes on
# to do. afws-run adds [remote] when work leaves this Mac, so the pair reads
# "started here, ran there" and a lone [local] means it never left.
#
# Suppressing [local] for a command that is only an afws-run invocation was
# tried and removed: the agent does not hand this script a bare command line,
# it hands over a wrapped one, so the test never matched anything real. Any
# version of it that did would have to guess at that wrapping, and guessing
# wrong labels a locally-run command as remote -- the one mistake this exists
# to prevent.
marker="${AFWS_MARKER:-local}"
printf '[%s] ' "$marker" >&2

# AFWS_SHELL exists so an unusual setup can choose its shell; anything that is
# not an executable file falls back rather than breaking every command.
shell="${AFWS_SHELL:-/bin/zsh}"
if [ ! -x "$shell" ]; then
  shell=/bin/zsh
fi

"$shell" -c "$1"
command_status=$?

# 127 is "not found here", which inside a session almost always means the
# command lives on the workstation rather than on this Mac.
if [ "$command_status" -eq 127 ] && [ -n "${AFWS_SSH_HOST-}" ]; then
  printf '[%s] not found on this Mac. for %s, use: afws-run <command>\n' \
    "$marker" "$AFWS_SSH_HOST" >&2
fi

exit "$command_status"
