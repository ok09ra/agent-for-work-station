#!/bin/zsh

set -eu

readonly SCRIPT_DIR="${0:A:h}"
readonly MOUNT_BASE="${CLAUDEFWS_MOUNT_BASE:-${HOME}/claudefws-mounts}"
readonly MOUNT_COMMAND="${CLAUDEFWS_MOUNT_COMMAND:-mount}"

force=0
dry_run=0
orphaned=0
list_only=0
ssh_host=""
remote_dir=""

usage() {
  print -r -- "Usage:"
  print -r -- "  claudefws-umount SSH_CONFIG_HOST REMOTE_ABSOLUTE_DIRECTORY [--force]"
  print -r -- "  claudefws-umount --orphaned [--force]"
  print -r -- "  claudefws-umount --list"
  print -r -- ""
  print -r -- "Releases mounts that claudefws created under the mount base. A session"
  print -r -- "normally unmounts its own workspace when it exits; this command is for a"
  print -r -- "mount left behind by a background session, by a session that was killed,"
  print -r -- "or by a dead sshfs process."
  print -r -- ""
  print -r -- "Options:"
  print -r -- "  --orphaned     Release every claudefws mount no live session is using."
  print -r -- "  --list         Show claudefws mounts and how many sessions use each."
  print -r -- "  --force        Use 'diskutil unmount force' when a plain umount fails."
  print -r -- "  -n, --dry-run  Print what would be released, change nothing."
}

die() {
  print -u2 -r -- "claudefws-umount: $*"
  exit 2
}

while (( $# > 0 )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --orphaned) orphaned=1; shift ;;
    --list) list_only=1; shift ;;
    --force) force=1; shift ;;
    -n|--dry-run) dry_run=1; shift ;;
    -*) die "unknown option: $1" ;;
    *)
      if [[ -z "$ssh_host" ]]; then
        ssh_host="$1"
      elif [[ -z "$remote_dir" ]]; then
        remote_dir="$1"
      else
        die "unexpected argument: $1"
      fi
      shift
      ;;
  esac
done

if (( list_only )) || (( orphaned )); then
  [[ -z "$ssh_host" ]] || die "--orphaned and --list take no host or directory"
else
  [[ -n "$ssh_host" && -n "$remote_dir" ]] || { usage >&2; exit 2; }
  case "$ssh_host" in
    ''|-*|*[!A-Za-z0-9._-]*) die "invalid SSH config host name" ;;
  esac
  [[ "$remote_dir" == /* ]] || die "remote directory must be an absolute path"
  [[ "$remote_dir" == *[[:cntrl:]]* ]] && die "remote directory must not contain control characters"
  remote_dir="${remote_dir%/}"
fi

# Every claudefws mount point currently in the mount table.
typeset -a claudefws_mounts
claudefws_mounts=()

collect_mounts() {
  local mount_line remainder mount_path

  while IFS= read -r mount_line; do
    remainder="${mount_line#* on }"
    mount_path="${remainder%% \(*}"
    [[ "$mount_path" == "${MOUNT_BASE}/"* ]] || continue
    claudefws_mounts+=("$mount_path")
  done < <(${=MOUNT_COMMAND})
}

users_of() {
  local point="$1" users

  if [[ -x "${SCRIPT_DIR}/claudefws-peers" ]]; then
    users="$("${SCRIPT_DIR}/claudefws-peers" --users-of-mount "$point" 2>/dev/null)" || users=0
  else
    users=0
  fi

  print -r -- "$users"
}

release() {
  local point="$1"

  if (( dry_run )); then
    print -r -- "Would unmount ${point}"
    return 0
  fi

  print -r -- "Unmounting ${point}"
  if umount "$point" 2>/dev/null; then
    return 0
  fi

  if (( force )); then
    if diskutil unmount force "$point" >/dev/null 2>&1; then
      print -r -- "  released with diskutil unmount force"
      return 0
    fi
  fi

  print -u2 -r -- "claudefws-umount: could not unmount ${point}"
  print -u2 -r -- "  close anything sitting in it, then retry with --force"
  return 1
}

collect_mounts

if (( list_only )); then
  if (( ${#claudefws_mounts} == 0 )); then
    print -r -- "No claudefws mounts are present."
    exit 0
  fi
  printf '%-8s %s\n' SESSIONS "MOUNT POINT"
  for point in "${claudefws_mounts[@]}"; do
    printf '%-8s %s\n' "$(users_of "$point")" "$point"
  done
  exit 0
fi

failures=0

if (( orphaned )); then
  released=0
  for point in "${claudefws_mounts[@]}"; do
    if [[ "$(users_of "$point")" == 0 ]]; then
      release "$point" || failures=$(( failures + 1 ))
      released=$(( released + 1 ))
    fi
  done
  if (( released == 0 )); then
    print -r -- "Every claudefws mount is still in use by a live session."
  fi
  (( failures == 0 )) || exit 1
  exit 0
fi

target="${MOUNT_BASE}/${ssh_host}${remote_dir}"

if [[ ${claudefws_mounts[(Ie)$target]} -eq 0 ]]; then
  print -r -- "Not mounted: ${target}"
  exit 0
fi

users="$(users_of "$target")"
if [[ "$users" != 0 ]] && (( ! force )); then
  die "${users} live session(s) are still working in ${target}
Check them with claudefws-peers, or pass --force to unmount anyway."
fi

release "$target" || exit 1
