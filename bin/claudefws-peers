#!/bin/zsh

set -eu

readonly STATE_DIR="${CLAUDEFWS_STATE_DIR:-${HOME}/.claudefws}"
readonly SESSION_DIR="${STATE_DIR}/sessions"
# A record written just before Claude starts is not yet visible to
# 'claude agents', so young records are never pruned.
readonly REGISTRATION_GRACE_SECONDS=90

mode=list
query_value=""
filter_host=""
same_only=0
quiet=0
as_json=0
no_prune=0

usage() {
  print -r -- "Usage:"
  print -r -- "  claudefws-peers [--host SSH_CONFIG_HOST] [--same] [--json]"
  print -r -- "  claudefws-peers --prune [--quiet]"
  print -r -- "  claudefws-peers --count"
  print -r -- "  claudefws-peers --users-of-mount MOUNT_POINT"
  print -r -- "  claudefws-peers --users-of-host SSH_CONFIG_HOST"
  print -r -- ""
  print -r -- "Lists the Claude for Work Station sessions on this Mac and the SSH host"
  print -r -- "and remote directory each one is working on. Dead records are removed"
  print -r -- "before listing."
  print -r -- ""
  print -r -- "Options:"
  print -r -- "  --host HOST  Only sessions attached to this SSH config host."
  print -r -- "  --same       Only sessions sharing this session's remote directory."
  print -r -- "  --json       Machine-readable output."
  print -r -- "  --prune      Remove dead records and print nothing else."
  print -r -- "  --count      Print the number of live peer sessions, excluding this one."
  print -r -- "  --users-of-mount POINT  Count live sessions whose workspace is in this mount,"
  print -r -- "                          excluding this one. Used to decide whether a mount is"
  print -r -- "                          still needed."
  print -r -- "  --users-of-host HOST    Count live sessions on this SSH host, excluding this one."
  print -r -- "  --quiet      Suppress informational output."
  print -r -- "  --no-prune   Never delete records; hide dead ones instead."
}

die() {
  print -u2 -r -- "claudefws-peers: $*"
  exit 2
}

while (( $# > 0 )); do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --host)
      (( $# >= 2 )) || die "--host requires an SSH config host name"
      filter_host="$2"
      shift 2
      ;;
    --same)
      same_only=1
      shift
      ;;
    --json)
      as_json=1
      shift
      ;;
    --prune)
      mode=prune
      shift
      ;;
    --count)
      mode=count
      shift
      ;;
    --users-of-mount)
      (( $# >= 2 )) || die "--users-of-mount requires a mount point"
      mode=users_of_mount
      query_value="$2"
      shift 2
      ;;
    --users-of-host)
      (( $# >= 2 )) || die "--users-of-host requires an SSH config host name"
      mode=users_of_host
      query_value="$2"
      shift 2
      ;;
    --quiet)
      quiet=1
      shift
      ;;
    --no-prune)
      no_prune=1
      shift
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

if [[ -n "$filter_host" ]]; then
  case "$filter_host" in
    ''|-*|*[!A-Za-z0-9._-]*)
      die "invalid SSH config host name"
      ;;
  esac
fi

# --- live session table from Claude Code ----------------------------------

typeset -A live_status
live_table_loaded=0

load_live_table() {
  (( live_table_loaded )) && return 0
  live_table_loaded=1

  command -v claude >/dev/null 2>&1 || return 0
  command -v plutil >/dev/null 2>&1 || return 0

  local listing index name session_state
  listing="$(mktemp "${TMPDIR:-/tmp}/claudefws-agents.XXXXXX")" || return 0

  if ! claude agents --json >"$listing" 2>/dev/null || [[ ! -s "$listing" ]]; then
    rm -f "$listing"
    return 0
  fi

  index=0
  while (( index < 512 )); do
    name="$(plutil -extract "${index}.name" raw -o - -- "$listing" 2>/dev/null)" || break
    [[ -n "$name" ]] || break
    session_state="$(plutil -extract "${index}.status" raw -o - -- "$listing" 2>/dev/null || print -r -- unknown)"
    live_status[$name]="${session_state:-unknown}"
    index=$(( index + 1 ))
  done

  rm -f "$listing"
  return 0
}

claude_knows_session() {
  load_live_table
  [[ -n "${live_status[$1]-}" ]]
}

session_status() {
  load_live_table
  print -r -- "${live_status[$1]-unknown}"
}

# --- registry -------------------------------------------------------------

record_session_name=""
record_kind=""
record_pid=""
record_bg_id=""
record_ssh_host=""
record_remote_dir=""
record_local_workspace=""
record_mount_point=""
record_started_at=""
record_started_epoch=""

read_record() {
  local file="$1" line key value

  record_session_name=""
  record_kind=""
  record_pid=""
  record_bg_id=""
  record_ssh_host=""
  record_remote_dir=""
  record_local_workspace=""
  record_mount_point=""
  record_started_at=""
  record_started_epoch=""

  while IFS= read -r line; do
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      session_name) record_session_name="$value" ;;
      kind) record_kind="$value" ;;
      pid) record_pid="$value" ;;
      bg_id) record_bg_id="$value" ;;
      ssh_host) record_ssh_host="$value" ;;
      remote_dir) record_remote_dir="$value" ;;
      local_workspace) record_local_workspace="$value" ;;
      mount_point) record_mount_point="$value" ;;
      started_at) record_started_at="$value" ;;
      started_epoch) record_started_epoch="$value" ;;
    esac
  done < "$file"

  [[ -n "$record_session_name" ]]
}

record_is_live() {
  local now age

  # Claude Code's own listing is authoritative for both kinds of session.
  if claude_knows_session "$record_session_name"; then
    return 0
  fi

  # A record written just before the session registered itself is not dead yet.
  if [[ -n "$record_started_epoch" ]]; then
    now="$(date +%s)"
    age=$(( now - record_started_epoch ))
    if (( age < REGISTRATION_GRACE_SECONDS )); then
      return 0
    fi
  fi

  # Fall back to the recorded process when the listing is unavailable, for
  # example before Claude Code has been signed in. An interactive session
  # keeps the launcher's PID across exec, so the recorded PID is the live
  # Claude process.
  if [[ -n "$record_pid" ]] && kill -0 "$record_pid" 2>/dev/null; then
    return 0
  fi

  return 1
}

typeset -a live_records
live_records=()

collect_live_records() {
  local file

  [[ -d "$SESSION_DIR" ]] || return 0

  for file in "$SESSION_DIR"/*.conf(N); do
    if ! read_record "$file"; then
      (( no_prune )) || rm -f "$file"
      continue
    fi

    if ! record_is_live; then
      (( no_prune )) || rm -f "$file"
      continue
    fi

    live_records+=("$file")
  done

  return 0
}

collect_live_records

if [[ "$mode" == users_of_mount || "$mode" == users_of_host ]]; then
  self_name="${CLAUDEFWS_SESSION_NAME-}"
  users=0
  for file in "${live_records[@]}"; do
    read_record "$file" || continue
    [[ -n "$self_name" && "$record_session_name" == "$self_name" ]] && continue
    if [[ "$mode" == users_of_host ]]; then
      [[ "$record_ssh_host" == "$query_value" ]] || continue
    else
      # The workspace is the mount point itself, or a directory inside it.
      [[ "$record_mount_point" == "$query_value" ||
         "$record_local_workspace" == "$query_value" ||
         "$record_local_workspace" == "${query_value}/"* ]] || continue
    fi
    users=$(( users + 1 ))
  done
  print -r -- "$users"
  exit 0
fi

if [[ "$mode" == prune ]] && (( no_prune )); then
  die "--prune and --no-prune are contradictory"
fi

if [[ "$mode" == prune ]]; then
  (( quiet )) || print -r -- "Registry holds ${#live_records} live session(s)."
  exit 0
fi

# --- filtering ------------------------------------------------------------

self_name="${CLAUDEFWS_SESSION_NAME-}"
self_host="${CLAUDEFWS_SSH_HOST-}"
self_remote_dir="${CLAUDEFWS_REMOTE_DIR-}"

if (( same_only )) && [[ -z "$self_host" || -z "$self_remote_dir" ]]; then
  # Fall back to the workspace the caller is standing in.
  local_file=""
  for local_file in "${live_records[@]}"; do
    read_record "$local_file" || continue
    if [[ -n "$record_local_workspace" && ( "$PWD" == "$record_local_workspace" || "$PWD" == "${record_local_workspace}/"* ) ]]; then
      self_host="$record_ssh_host"
      self_remote_dir="$record_remote_dir"
      break
    fi
  done
  if [[ -z "$self_host" ]]; then
    die "--same needs a Claude for Work Station session; no CLAUDEFWS_SSH_HOST and no matching workspace"
  fi
fi

typeset -a shown_records
shown_records=()

for file in "${live_records[@]}"; do
  read_record "$file" || continue

  if [[ -n "$filter_host" && "$record_ssh_host" != "$filter_host" ]]; then
    continue
  fi

  if (( same_only )); then
    [[ "$record_ssh_host" == "$self_host" ]] || continue
    [[ "$record_remote_dir" == "$self_remote_dir" ]] || continue
  fi

  shown_records+=("$file")
done

if [[ "$mode" == count ]]; then
  count=0
  for file in "${shown_records[@]}"; do
    read_record "$file" || continue
    [[ -n "$self_name" && "$record_session_name" == "$self_name" ]] && continue
    count=$(( count + 1 ))
  done
  print -r -- "$count"
  exit 0
fi

# --- output ---------------------------------------------------------------

json_escape() {
  local text="$1"
  text="${text//\\/\\\\}"
  text="${text//\"/\\\"}"
  print -r -- "$text"
}

if (( as_json )); then
  print -r -- "["
  first=1
  for file in "${shown_records[@]}"; do
    read_record "$file" || continue
    (( first )) || print -r -- ","
    first=0
    print -n -r -- "  {"
    print -n -r -- "\"session_name\":\"$(json_escape "$record_session_name")\","
    print -n -r -- "\"kind\":\"$(json_escape "$record_kind")\","
    print -n -r -- "\"status\":\"$(json_escape "$(session_status "$record_session_name")")\","
    print -n -r -- "\"pid\":\"$(json_escape "$record_pid")\","
    print -n -r -- "\"bg_id\":\"$(json_escape "$record_bg_id")\","
    print -n -r -- "\"ssh_host\":\"$(json_escape "$record_ssh_host")\","
    print -n -r -- "\"remote_dir\":\"$(json_escape "$record_remote_dir")\","
    print -n -r -- "\"local_workspace\":\"$(json_escape "$record_local_workspace")\","
    print -n -r -- "\"mount_point\":\"$(json_escape "$record_mount_point")\","
    print -n -r -- "\"started_at\":\"$(json_escape "$record_started_at")\","
    print -n -r -- "\"self\":$( [[ -n "$self_name" && "$record_session_name" == "$self_name" ]] && print -n -- true || print -n -- false )"
    print -n -r -- "}"
  done
  (( first )) || print -r -- ""
  print -r -- "]"
  exit 0
fi

if (( ${#shown_records} == 0 )); then
  (( quiet )) || print -r -- "No Claude for Work Station sessions are registered."
  exit 0
fi

printf '%-28s %-12s %-8s %-18s %s\n' SESSION KIND STATUS "SSH HOST" "REMOTE DIRECTORY"
for file in "${shown_records[@]}"; do
  read_record "$file" || continue
  marker=""
  [[ -n "$self_name" && "$record_session_name" == "$self_name" ]] && marker=" (this session)"
  printf '%-28s %-12s %-8s %-18s %s%s\n' \
    "$record_session_name" \
    "$record_kind" \
    "$(session_status "$record_session_name")" \
    "$record_ssh_host" \
    "$record_remote_dir" \
    "$marker"
done
