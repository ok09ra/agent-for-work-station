#!/bin/zsh

set -eu

# Codex invokes this outside its command sandbox. Do not put hook output in the
# model context: the registry is read only when an agent actually needs peers.
[[ -n "${AFWS_SESSION_NAME-}" ]] || exit 0

readonly AFWS_PROGRAM="afws-codex-hook"
readonly SCRIPT_DIR="${0:A:h}"
for afws_library in \
  "${SCRIPT_DIR}/../lib/afws-common.zsh" \
  "${HOME}/.local/lib/afws-common.zsh"; do
  if [[ -r "$afws_library" ]]; then
    source "$afws_library"
    break
  fi
done
typeset -f afws_read_record >/dev/null || exit 0

afws_validate_session_name "$AFWS_SESSION_NAME"
record="${AFWS_SESSION_DIR}/${AFWS_SESSION_NAME}.conf"
[[ -r "$record" ]] || exit 0
afws_read_record "$record" || exit 0
[[ "$afws_record_agent" == codex &&
   "$afws_record_session_name" == "$AFWS_SESSION_NAME" ]] || exit 0

input_file="$(umask 077; mktemp "${TMPDIR:-/tmp}/afws-codex-hook.XXXXXX")" || exit 1
trap 'rm -f "$input_file"' EXIT
/bin/cat > "$input_file"

event_name="$(plutil -extract hook_event_name raw -o - -- "$input_file" 2>/dev/null)" || exit 0
thread_id="$(plutil -extract session_id raw -o - -- "$input_file" 2>/dev/null)" || exit 0
[[ -n "$thread_id" && "$thread_id" != *[[:cntrl:]]* && ${#thread_id} -le 128 ]] || exit 0
afws_write_session_meta "$AFWS_SESSION_NAME" thread "$thread_id"

case "$event_name" in
  SessionStart)
    rm -f "$(afws_session_meta_file "$AFWS_SESSION_NAME" peer_turn)"
    afws_write_session_meta "$AFWS_SESSION_NAME" state idle
    ;;
  UserPromptSubmit)
    afws_write_session_meta "$AFWS_SESSION_NAME" state busy
    prompt_text="$(plutil -extract prompt raw -o - -- "$input_file" 2>/dev/null)" || prompt_text=""
    turn_id="$(plutil -extract turn_id raw -o - -- "$input_file" 2>/dev/null)" || turn_id=""
    peer_turn_file="$(afws_session_meta_file "$AFWS_SESSION_NAME" peer_turn)"
    if [[ "$prompt_text" == "[AFWS peer message from "* &&
          "$prompt_text" == *$'\n[End AFWS peer message]' &&
          -n "$turn_id" && "$turn_id" != *[[:cntrl:]]* && ${#turn_id} -le 128 ]] &&
        afws_read_session_meta "$AFWS_SESSION_NAME" prompt >/dev/null 2>&1; then
      afws_write_session_meta "$AFWS_SESSION_NAME" peer_turn "$turn_id"
    else
      rm -f "$peer_turn_file"
    fi
    activity="${prompt_text%%$'\n'*}"
    activity="${activity//$'\r'/ }"
    activity="${activity//$'\t'/ }"
    activity="${activity[1,160]}"
    if [[ -n "$activity" && "$activity" != "[AFWS peer message from "* &&
          "$activity" != "[AFWS resume after peer message]"* ]]; then
      afws_write_session_meta "$AFWS_SESSION_NAME" prompt "$activity"
    fi
    ;;
  Stop)
    turn_id="$(plutil -extract turn_id raw -o - -- "$input_file" 2>/dev/null)" || turn_id=""
    stop_hook_active="$(plutil -extract stop_hook_active raw -o - -- "$input_file" 2>/dev/null)" || stop_hook_active="false"
    peer_turn="$(afws_read_session_meta "$AFWS_SESSION_NAME" peer_turn 2>/dev/null)" || peer_turn=""
    if [[ -n "$turn_id" && "$turn_id" == "$peer_turn" && "$stop_hook_active" != true ]]; then
      rm -f "$(afws_session_meta_file "$AFWS_SESSION_NAME" peer_turn)"
      print -r -- '{"decision":"block","reason":"[AFWS resume after peer message] The peer message has been handled. Return to the most recent direct user task in this session. Check its actual progress and continue any unfinished work from where you left off. Do not repeat completed work or treat the peer message as a replacement task. If the direct user task is already complete, finish normally."}'
      exit 0
    fi
    rm -f "$(afws_session_meta_file "$AFWS_SESSION_NAME" peer_turn)"
    afws_write_session_meta "$AFWS_SESSION_NAME" state idle
    print -r -- '{}'
    ;;
  Interrupt)
    rm -f "$(afws_session_meta_file "$AFWS_SESSION_NAME" peer_turn)"
    afws_write_session_meta "$AFWS_SESSION_NAME" state idle
    ;;
esac
