#!/bin/zsh

set -eu

readonly SCRIPT_DIR="${0:A:h}"
readonly RUNNER="${SCRIPT_DIR}/claudefws-run"

usage() {
  print -r -- "Usage:"
  print -r -- "  ws-run COMMAND [ARG ...]"
  print -r -- "  SCRIPT | ws-run"
  print -r -- ""
  print -r -- "Runs COMMAND on the workstation this session is attached to, in the"
  print -r -- "session's remote directory. Short enough to type after Claude Code's '!'"
  print -r -- "escape, which otherwise runs the command on this Mac."
  print -r -- ""
  print -r -- "  ws-run nvidia-smi"
  print -r -- "  ws-run python train.py"
  print -r -- "  ws-run sh -c 'ls *.log | wc -l'   # shell syntax needs a remote shell"
  print -r -- ""
  print -r -- "Every argument is part of the remote command, so no '--' is needed."
  print -r -- "Shell metacharacters are passed through literally rather than being"
  print -r -- "interpreted on the remote host, so wrap a pipeline or a redirect in"
  print -r -- "'sh -c' when the remote shell should see it."
  print -r -- ""
  print -r -- "The host and directory come from CLAUDEFWS_SSH_HOST and"
  print -r -- "CLAUDEFWS_REMOTE_DIR, which claudefws exports into the session."
  print -r -- ""
  print -r -- "This is a thin wrapper around: claudefws-run -- COMMAND [ARG ...]"
}

die() {
  print -u2 -r -- "ws-run: $*"
  exit 2
}

if [[ "${1-}" == "-h" || "${1-}" == "--help" ]]; then
  usage
  exit 0
fi

[[ -x "$RUNNER" ]] || die "claudefws-run is not installed next to ws-run"

if [[ -z "${CLAUDEFWS_SSH_HOST-}" ]]; then
  die "no workstation in this environment; CLAUDEFWS_SSH_HOST is not set
ws-run is meant to be used inside a session started by claudefws."
fi

if (( $# == 0 )); then
  if [[ -t 0 ]]; then
    usage >&2
    exit 2
  fi
  # A script on standard input is forwarded as-is.
  exec "$RUNNER"
fi

exec "$RUNNER" -- "$@"
