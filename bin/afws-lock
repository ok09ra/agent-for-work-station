#!/bin/zsh

set -eu

readonly AFWS_PROGRAM="afws-lock"
readonly SCRIPT_DIR="${0:A:h}"

for afws_library in \
  "${SCRIPT_DIR}/../lib/afws-common.zsh" \
  "${HOME}/.local/lib/afws-common.zsh"; do
  if [[ -r "$afws_library" ]]; then
    source "$afws_library"
    break
  fi
done

if ! typeset -f afws_die >/dev/null; then
  print -u2 -r -- "${AFWS_PROGRAM}: cannot find lib/afws-common.zsh; run ./scripts/install.sh"
  exit 2
fi

readonly DEFAULT_REMOTE_BASE="~/.afws-locks"
remote_base="$AFWS_REMOTE_LOCK_DIR"
ssh_host="${AFWS_SSH_HOST-}"
lock_name=""
wait_seconds=0
ttl_seconds="$AFWS_LOCK_TTL"
dry_run=0
action=""

usage() {
  print -r -- "Usage:"
  print -r -- "  afws-lock acquire NAME [--host SSH_CONFIG_HOST] [--wait SECONDS] [--ttl SECONDS]"
  print -r -- "  afws-lock release NAME [--host SSH_CONFIG_HOST]"
  print -r -- "  afws-lock status  [NAME] [--host SSH_CONFIG_HOST]"
  print -r -- "  afws-lock steal   NAME [--host SSH_CONFIG_HOST]"
  print -r -- ""
  print -r -- "Claims an exclusive resource on the remote workstation so that several"
  print -r -- "sessions, of either agent, do not use it at the same time. A lock is a"
  print -r -- "directory created atomically on the remote host; nothing is written inside"
  print -r -- "the project tree. Locks are per host, not per directory, because a GPU is"
  print -r -- "shared by every session on that workstation."
  print -r -- ""
  print -r -- "Options:"
  print -r -- "  --host HOST     SSH config host (default: AFWS_SSH_HOST)"
  print -r -- "  --wait SECONDS  Retry acquire until the lock is free or the time runs out"
  print -r -- "  --ttl SECONDS   Mark the lock stale after this long (default: 7200)"
  print -r -- "  -n, --dry-run   Print the planned SSH command and remote script only"
  print -r -- ""
  print -r -- "Exit status: 0 success, 2 usage error, 3 lock held, 4 refused"
  print -r -- ""
  print -r -- "Environment:"
  print -r -- "  AFWS_SESSION_NAME     Recorded as the lock holder"
  print -r -- "  AFWS_REMOTE_LOCK_DIR  Remote lock root (default: ~/.afws-locks)"
  print -r -- "  AFWS_LOCK_TTL         Default TTL in seconds"
}

if (( $# == 0 )); then
  usage >&2
  exit 2
fi

case "$1" in
  -h|--help) usage; exit 0 ;;
  acquire|release|status|steal) action="$1"; shift ;;
  *) afws_die "unknown action: $1 (expected acquire, release, status, or steal)" ;;
esac

if (( $# > 0 )) && [[ "$1" != -* ]]; then
  lock_name="$1"
  shift
fi

while (( $# > 0 )); do
  case "$1" in
    --host)
      (( $# >= 2 )) || afws_die "--host requires an SSH config host name"
      ssh_host="$2"; shift 2 ;;
    --wait)
      (( $# >= 2 )) || afws_die "--wait requires a number of seconds"
      wait_seconds="$2"; shift 2 ;;
    --ttl)
      (( $# >= 2 )) || afws_die "--ttl requires a number of seconds"
      ttl_seconds="$2"; shift 2 ;;
    -n|--dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) afws_die "unknown option: $1" ;;
  esac
done

[[ -n "$ssh_host" ]] ||
  afws_die "no SSH host given and AFWS_SSH_HOST is not set; pass --host"
afws_validate_host "$ssh_host"

if [[ "$action" != status && -z "$lock_name" ]]; then
  afws_die "${action} requires a lock name"
fi

if [[ -n "$lock_name" ]]; then
  case "$lock_name" in
    -*|*[!A-Za-z0-9._-]*)
      afws_die "lock name may contain only letters, numbers, '.', '_', and '-'"
      ;;
  esac
fi

case "$wait_seconds" in
  ''|*[!0-9]*) afws_die "--wait must be a whole number of seconds" ;;
esac

case "$ttl_seconds" in
  ''|*[!0-9]*) afws_die "--ttl must be a whole number of seconds" ;;
esac

if [[ "$remote_base" != "$DEFAULT_REMOTE_BASE" && "$remote_base" != /* ]]; then
  afws_die "AFWS_REMOTE_LOCK_DIR must be an absolute remote path"
fi

[[ "$remote_base" != *[[:cntrl:]]* ]] ||
  afws_die "AFWS_REMOTE_LOCK_DIR must not contain control characters"

holder="${AFWS_SESSION_NAME:-${USER:-unknown}@$(hostname -s 2>/dev/null || print -r -- localhost)}"
case "$holder" in
  *[!A-Za-z0-9._@-]*) holder="unnamed-session" ;;
esac

# --- remote scripts -------------------------------------------------------
# Sent over standard input, so the local shell never has to nest quotes.
# Positional arguments: $1 lock name, $2 holder, $3 ttl, $4 remote base,
# $5 force flag.

readonly PRELUDE='set -eu
lock_name=$1
holder=$2
ttl=$3
base=$4
force=$5
case $base in
  "~/"*) base=$HOME/${base#"~/"} ;;
esac
'

readonly ACQUIRE_SCRIPT='(umask 077; mkdir -p "$base")
chmod 700 "$base" 2>/dev/null || true
lock="$base/$lock_name"
if mkdir "$lock" 2>/dev/null; then
  {
    echo "holder=$holder"
    echo "acquired_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "acquired_epoch=$(date +%s)"
    echo "ttl=$ttl"
  } > "$lock/owner"
  echo "acquired $lock_name by $holder"
  exit 0
fi
echo "held $lock_name"
cat "$lock/owner" 2>/dev/null || true
exit 3
'

readonly RELEASE_SCRIPT='lock="$base/$lock_name"
if [ ! -d "$lock" ]; then
  echo "not held $lock_name"
  exit 0
fi
current=
if [ -f "$lock/owner" ]; then
  while IFS= read -r line; do
    case $line in
      holder=*) current=${line#holder=} ;;
    esac
  done < "$lock/owner"
fi
if [ "$force" != 1 ] && [ -n "$current" ] && [ "$current" != "$holder" ]; then
  echo "refusing to release $lock_name held by $current"
  exit 4
fi
rm -f "$lock/owner"
rmdir "$lock"
if [ "$force" = 1 ] && [ -n "$current" ] && [ "$current" != "$holder" ]; then
  echo "stole $lock_name from $current"
else
  echo "released $lock_name"
fi
exit 0
'

readonly STATUS_SCRIPT='if [ ! -d "$base" ]; then
  echo "no locks on this host"
  exit 0
fi
now=$(date +%s)
found=0
for lock in "$base"/*; do
  [ -d "$lock" ] || continue
  name=${lock##*/}
  if [ -n "$lock_name" ] && [ "$name" != "$lock_name" ]; then
    continue
  fi
  found=1
  current=
  acquired_at=
  acquired_epoch=0
  lock_ttl=0
  if [ -f "$lock/owner" ]; then
    while IFS= read -r line; do
      case $line in
        holder=*) current=${line#holder=} ;;
        acquired_at=*) acquired_at=${line#acquired_at=} ;;
        acquired_epoch=*) acquired_epoch=${line#acquired_epoch=} ;;
        ttl=*) lock_ttl=${line#ttl=} ;;
      esac
    done < "$lock/owner"
  fi
  age=$((now - acquired_epoch))
  state=held
  if [ "$lock_ttl" -gt 0 ] && [ "$age" -gt "$lock_ttl" ]; then
    state=stale
  fi
  echo "$state $name holder=$current since=$acquired_at age=${age}s ttl=${lock_ttl}s"
done
if [ "$found" = 0 ]; then
  if [ -n "$lock_name" ]; then
    echo "free $lock_name"
  else
    echo "no locks on this host"
  fi
fi
exit 0
'

force=0
case "$action" in
  acquire) remote_script="${PRELUDE}${ACQUIRE_SCRIPT}" ;;
  release) remote_script="${PRELUDE}${RELEASE_SCRIPT}" ;;
  steal)   remote_script="${PRELUDE}${RELEASE_SCRIPT}"; force=1 ;;
  status)  remote_script="${PRELUDE}${STATUS_SCRIPT}" ;;
esac

remote_command="bash -s -- ${(q)lock_name} ${(q)holder} ${(q)ttl_seconds} ${(q)remote_base} ${force}"

# Reuse the authenticated connection a launcher opened.
afws_control_ssh_options "$ssh_host"
ssh_options=("${afws_ssh_control_options[@]}")

if (( dry_run )); then
  if (( ${#ssh_options} > 0 )); then
    print -r -- "ssh ${ssh_options} ${ssh_host} ${(q)remote_command}"
  else
    print -r -- "ssh ${ssh_host} ${(q)remote_command}"
  fi
  print -r -- "--- remote script ---"
  print -r -- "$remote_script"
  exit 0
fi

command -v ssh >/dev/null 2>&1 || afws_die "ssh not found"

run_remote() {
  local exit_status=0

  set +e
  printf '%s' "$remote_script" | ssh "${ssh_options[@]}" "$ssh_host" "$remote_command"
  exit_status=$?
  set -e

  afws_report_control_fallback "$ssh_host" "$exit_status"

  return "$exit_status"
}

if [[ "$action" == acquire && "$wait_seconds" -gt 0 ]]; then
  deadline=$(( $(date +%s) + wait_seconds ))
  while :; do
    exit_status=0
    run_remote || exit_status=$?

    if (( exit_status == 0 )); then
      exit 0
    fi

    if (( exit_status != 3 )); then
      exit "$exit_status"
    fi

    if (( $(date +%s) >= deadline )); then
      print -u2 -r -- "${AFWS_PROGRAM}: gave up waiting for ${lock_name} after ${wait_seconds}s"
      exit 3
    fi

    afws_pause_seconds 5
  done
fi

exit_status=0
run_remote || exit_status=$?
exit "$exit_status"
