# Copy only the entries you need into your local SSH config.
# Never put real connection details or credentials in this repository.

Host example-workstation
  HostName host.example.invalid
  User remote-user
  AddKeysToAgent yes
  UseKeychain yes

# Use one alias per machine. Sessions that name the same alias share one
# authenticated connection and one mount; a second alias for the same machine
# would open a second connection and mount it a second time.
#
# A second entry is for a second machine.
Host example-gpu-node
  HostName host.example.invalid
  User remote-user
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 30
  ServerAliveCountMax 6
